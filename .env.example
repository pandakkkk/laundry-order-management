# --- Server ---
PORT=5001
NODE_ENV=development

# --- MongoDB ---
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>/<db>?retryWrites=true&w=majority

# --- JWT (staff + customer tokens use the same secret) ---
JWT_SECRET=change-me-to-a-long-random-value
JWT_EXPIRE=7d

# --- Public API (customer frontend routes that don't use JWT) ---
PUBLIC_API_KEY=

# --- CORS allow-list additions (the primary domain is hardcoded) ---
WBL_FE_ORIGIN=http://localhost:5173

# --- Razorpay (India) ---
# Use rzp_test_* keys during development. Switch to live keys only after KYC.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx
RAZORPAY_KEY_SECRET=
# Set this on the Razorpay dashboard under Webhooks and paste here.
RAZORPAY_WEBHOOK_SECRET=

# --- WATI (WhatsApp Integration) ---
# Base API Endpoint (found under WATI Dashboard > Account Details > API Docs)
WATI_API_ENDPOINT=https://live-server-xxxx.wati.io
# Bearer Access Token generated in WATI Dashboard
WATI_AUTH_TOKEN=

# --- Notification defaults ---
# 'sms' | 'whatsapp' | 'both'
NOTIFICATION_TYPE=whatsapp

# --- Referral bonus (rupees credited to both parties on new customer first order) ---
REFERRAL_BONUS_AMOUNT=50

# --- Subscription cron ---
# Set to 'false' to disable the daily billing job (useful in tests).
SUBSCRIPTION_CRON_ENABLED=true
# Cron expression, IST timezone. Default: daily at 06:00.
SUBSCRIPTION_CRON=0 6 * * *

# --- Wallet reconciliation cron ---
WALLET_RECONCILIATION_ENABLED=true
WALLET_RECONCILIATION_CRON=30 3 * * *
# Optional: Slack incoming-webhook URL for reconciliation + ops alerts.
SLACK_WEBHOOK_URL=

# --- Email (nodemailer SMTP) ---
# When any of SMTP_HOST / SMTP_USER / SMTP_PASSWORD is missing, emails are silently skipped.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Lead alerts ---
# WhatsApp/SMS destination for new inquiries; defaults to business phone if omitted.
LEAD_ALERT_NUMBER=
