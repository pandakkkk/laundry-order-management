# ==========================================
# 🧺 LAUNDRY ORDER MANAGEMENT - PRODUCTION ENV CONFIG
# ==========================================

# --- Server Settings ---
PORT=5001
NODE_ENV=production

# --- MongoDB Atlas Database ---
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://admin_user:YourStrongPassword@cluster.mongodb.net/laundry-orders-prod?retryWrites=true&w=majority

# --- Authentication & JWT Security ---
# Generate a random 64-char string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_this_with_a_64_character_hex_string_for_production_security
JWT_EXPIRE=7d

# --- Public API Key ---
PUBLIC_API_KEY=lm_public_prod_key_2026

# --- CORS Approved Domain ---
WBL_FE_ORIGIN=https://laundryman.pro

# --- Razorpay Live Credentials (India) ---
# Replace with live keys from Razorpay Dashboard (Dashboard -> Account Settings -> API Keys)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_live_secret_key
# Razorpay Dashboard -> Webhooks -> Add Webhook: https://api.laundryman.pro/api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# --- Gupshup SMS & WhatsApp (DLT Approved) ---
GUPSHUP_API_KEY=your_gupshup_api_key
GUPSHUP_APP_NAME=LaundrymanPro
GUPSHUP_SOURCE_NUMBER=919006463666
NOTIFICATION_TYPE=both

# --- Nodemailer Transactional SMTP Email ---
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASSWORD=your_sendgrid_api_key
SMTP_FROM=no-reply@laundryman.pro

# --- Crons & Automation ---
SUBSCRIPTION_CRON_ENABLED=true
SUBSCRIPTION_CRON=0 6 * * *
WALLET_RECONCILIATION_ENABLED=true
WALLET_RECONCILIATION_CRON=30 3 * * *
